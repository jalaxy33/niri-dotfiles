#!/usr/bin/env bash
#
# 检查 niri 配置依赖，如果缺少就安装。支持的系统：archlinux
#

# ---- 文本样式 ----
BOLD=$(tput bold)
DIM=$(tput dim)
ITALIC=$(tput sitm)    # 斜体（部分终端支持）
UNDERLINE=$(tput smul) # 下划线
BLINK=$(tput blink)
REVERSE=$(tput rev)
STRIKE=$(tput smxx) # 删除线（部分终端支持，可能为空）
RESET=$(tput sgr0)  # 重置所有

# ---- 前景色（文字色） ----
BLACK=$(tput setaf 0)
RED=$(tput setaf 1)
GREEN=$(tput setaf 2)
YELLOW=$(tput setaf 3)
BLUE=$(tput setaf 4)
MAGENTA=$(tput setaf 5)
CYAN=$(tput setaf 6)
WHITE=$(tput setaf 7)

# ---- 背景色 ----
BG_BLACK=$(tput setab 0)
BG_RED=$(tput setab 1)
BG_GREEN=$(tput setab 2)
BG_YELLOW=$(tput setab 3)
BG_BLUE=$(tput setab 4)
BG_MAGENTA=$(tput setab 5)
BG_CYAN=$(tput setab 6)
BG_WHITE=$(tput setab 7)


dependencies=(
  "fish"
  "kitty"
  "thunar"
  "imv"
  "satty"
  "wl-clipboard"
  "ttf-jetbrains-maple-mono-nf-xx-xx"
  # GTK主题
  "adw-gtk-theme"
  "nwg-look"
)

echo "${BOLD}Niri dependes on: ${RESET}"
echo "    ${CYAN}${dependencies[@]}${RESET}"

# 只在支持的系统上安装
if [[ -f /etc/os-release ]]; then
  . /etc/os-release

  #-- archlinux
  if [[ $ID == "arch" ]]; then
    echo ""
    echo "${BOLD}==== Check & Install ====${RESET}"
    echo "${BOLD}${GREEN}Running${RESET}: sudo pacman -S --needed ${CYAN}${dependencies[@]}${RESET}"
    echo ""
    sudo pacman -S --needed "${dependencies[@]}"
    echo ""
    echo "${BOLD}==== DONE ====${RESET}"
  fi
fi
